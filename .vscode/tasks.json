{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flutter: pub get",
            "type": "shell",
            "command": "C:\\flutter-aurora\\bin\\flutter.bat",
            "args": ["pub", "get"],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Собрать Flutter RPM (Docker)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build_flutter_rpm.ps1"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
