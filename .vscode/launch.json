        },
        {
            "name": "Geometry Dash (Web Chrome)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "chrome"
        },
        {
            "name": "Собрать и Запустить в Авроре (Эмулятор)",
            "request": "launch",
            "type": "node-terminal",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\build_and_run_aurora.ps1\""
        }
    ]
}
